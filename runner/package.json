{
  "name": "stackspeak-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static, cross-site Python runner for StackSpeak (Pyodide in a hardened module Web Worker). See docs/python-runner.md.",
  "scripts": {
    "generate": "node scripts/generate-config.mjs",
    "check:config": "node scripts/generate-config.mjs --check",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vercel/routing-utils": "6.6.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
