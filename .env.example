# Copy to .env and fill in local values. Never commit a real .env file.

# --- Frontend (frontend/.env.local) ---
# Base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Run Code in the Fix stage (AUD-60). OFF unless BOTH are set; build-time values. Leave unset in production.
# The URL must be a bare https origin (http only for loopback) on a DIFFERENT site from the app.
# NEXT_PUBLIC_PYTHON_RUNNER_ENABLED=true
# NEXT_PUBLIC_PYTHON_RUNNER_URL=http://127.0.0.1:4010

# --- Backend (backend/.env) ---
# All backend settings are read with the STACKSPEAK_ prefix (see backend/app/core/config.py).
STACKSPEAK_APP_NAME=StackSpeak API
STACKSPEAK_ENVIRONMENT=development
STACKSPEAK_CORS_ORIGINS=["http://localhost:3000"]

# Postgres connection string. Not required for Sprint 01 (no persistence yet),
# reserved for the courses/challenges/progress data model in a future sprint.
STACKSPEAK_DATABASE_URL=postgresql://stackspeak:stackspeak@localhost:5432/stackspeak

# Classroom owner access (frontend SERVER ONLY; never NEXT_PUBLIC).
# Generate locally with frontend/scripts/classroom-credentials.mjs.
# Missing values leave teacher routes locked. Public deployment requires auth review
# and shared/platform login throttling; no production setup is implied here.
# CLASSROOM_PASSWORD_HASH=<salt hex>:<scrypt digest hex>
# CLASSROOM_SESSION_SECRET=<64+ characters of cryptographically random secret>
# Vercel Preview only: may omit origin to use trusted VERCEL_BRANCH_URL.
# Production always requires an explicit origin; no production setup is approved.
# CLASSROOM_ORIGIN=http://localhost:3000

# Private Classroom guide configuration (frontend SERVER ONLY; never commit values).
# Hosted preview: CLASSROOM_GUIDES_JSON is a private secret, maximum 48 KiB.
# Local only: CLASSROOM_GUIDES_FILE is an absolute path outside this repository.
# Vercel ignores the file option; absent/invalid data makes guides unavailable.
# CLASSROOM_GUIDES_JSON=<owner-supplied guide JSON>
# CLASSROOM_GUIDES_FILE=/absolute/private/path/guides.json

# Classroom Studio (AUD-78), proposed SERVER ONLY database access.
# Local/approved isolated Preview only until separate Production approval.
# No service-role/admin credentials in app runtime. No NEXT_PUBLIC database vars.
# Production uses classroom_reader_production / classroom_writer_production; Preview keeps the base names.
# CLASSROOM_DATABASE_READER_URL=postgres://classroom_reader@127.0.0.1:55478/postgres
# CLASSROOM_DATABASE_WRITER_URL=postgres://classroom_writer@127.0.0.1:55478/postgres
# Server-only PEM CA certificate for the remote pooler; preserve real newlines.
# Obtain through Supabase SSL settings; certificate/hostname checks stay enabled.
# CLASSROOM_DATABASE_CA_CERT=<PEM certificate>
# Default source-backed delivery remains enabled (seed). Local acceptance only:
# CLASSROOM_CONTENT_SOURCE=database
# CLASSROOM_RECOVERY_DIR=/absolute/private/path/classroom-publication
# Recovery rollback: CLASSROOM_CONTENT_SOURCE=recovery, same directory/tombstones.
# Never use Vercel ephemeral files; hosted database cutover remains blocked.
# See docs/classroom/studio/local-studio.md before changing delivery mode.
