# Copy to .env and fill in local values. Never commit a real .env file.

# --- Frontend (frontend/.env.local) ---
# Base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (backend/.env) ---
# All backend settings are read with the STACKSPEAK_ prefix (see backend/app/core/config.py).
STACKSPEAK_APP_NAME=StackSpeak API
STACKSPEAK_ENVIRONMENT=development
STACKSPEAK_CORS_ORIGINS=["http://localhost:3000"]

# Postgres connection string. Not required for Sprint 01 (no persistence yet),
# reserved for the courses/challenges/progress data model in a future sprint.
STACKSPEAK_DATABASE_URL=postgresql://stackspeak:stackspeak@localhost:5432/stackspeak
