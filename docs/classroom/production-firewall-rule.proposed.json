{
  "name": "AUD-53 Classroom login",
  "description": "Proposed only: preserve Preview policy; add Production login throttling after explicit approval.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "environment", "op": "eq", "value": "preview" },
        { "type": "route", "op": "eq", "value": "/classroom/session" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    },
    {
      "conditions": [
        { "type": "environment", "op": "eq", "value": "production" },
        { "type": "route", "op": "eq", "value": "/classroom/session" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    },
    {
      "conditions": [
        { "type": "environment", "op": "eq", "value": "production" },
        { "type": "path", "op": "re", "value": "^/classroom/session/?$" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 60,
        "limit": 10,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
