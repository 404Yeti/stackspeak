{
  "name": "AUD-53 Classroom preview login",
  "description": "Preview-only shared login throttle. Activate only after review of the initial project WAF configuration.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "environment", "op": "eq", "value": "preview" },
        { "type": "route", "op": "eq", "value": "/classroom/session" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 60,
        "limit": 10,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
